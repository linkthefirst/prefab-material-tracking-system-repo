{"version":"0.3.0","body":"interface MaterialRow {\n  Description: string;\n  Unit: string;\n  Quantity: number | string;\n  Notes?: string;\n}\n\nfunction main(\n  workbook: ExcelScript.Workbook,\n  workOrder: string,\n  foreman: string,\n  receiver: string,\n  dateTimeOut: string,\n  jobNumber: string,\n  materialRowsJson: string\n) {\n  const sheet = workbook.getWorksheet(\"SignOutSheet\");\n\n  const rows: MaterialRow[] = JSON.parse(materialRowsJson || \"[]\");\n\n  // Header fields\n  sheet.getRange(\"B5\").setValue(workOrder);\n  sheet.getRange(\"D5\").setValue(foreman);\n  sheet.getRange(\"F5\").setValue(dateTimeOut);\n  sheet.getRange(\"B7\").setValue(jobNumber);\n  sheet.getRange(\"D7\").setValue(receiver);\n\n  // Clear old material rows\n  for (let r = 11; r <= 35; r++) {\n    sheet.getRange(`B${r}`).setValue(\"\");\n    sheet.getRange(`C${r}`).setValue(\"\");\n    sheet.getRange(`D${r}`).setValue(\"\");\n\n    sheet.getRange(`F${r}`).setValue(\"\");\n    sheet.getRange(`G${r}`).setValue(\"\");\n    sheet.getRange(`H${r}`).setValue(\"\");\n  }\n\n  const startRow = 11;\n  const maxRowsPerSide = 25;\n  const maxRowsTotal = 50;\n\n  rows.slice(0, maxRowsTotal).forEach((row, index) => {\n    const targetRow = startRow + (index % maxRowsPerSide);\n\n    if (index < maxRowsPerSide) {\n      sheet.getRange(`B${targetRow}`).setValue(row.Description ?? \"\");\n      sheet.getRange(`C${targetRow}`).setValue(row.Unit ?? \"\");\n      sheet.getRange(`D${targetRow}`).setValue(row.Quantity ?? \"\");\n    } else {\n      sheet.getRange(`F${targetRow}`).setValue(row.Description ?? \"\");\n      sheet.getRange(`G${targetRow}`).setValue(row.Unit ?? \"\");\n      sheet.getRange(`H${targetRow}`).setValue(row.Quantity ?? \"\");\n    }\n  });\n\n  // Set print area\n  sheet.getPageLayout().setPrintArea(\"A1:H45\");\n}","description":"","noCodeMetadata":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[{\"name\":\"workOrder\",\"index\":0},{\"name\":\"foreman\",\"index\":1},{\"name\":\"receiver\",\"index\":2},{\"name\":\"dateTimeOut\",\"index\":3},{\"name\":\"jobNumber\",\"index\":4},{\"name\":\"materialRowsJson\",\"index\":5}],\"parameterSchema\":{\"type\":\"object\",\"required\":[\"workOrder\",\"foreman\",\"receiver\",\"dateTimeOut\",\"jobNumber\",\"materialRowsJson\"],\"properties\":{\"workOrder\":{\"type\":\"string\"},\"foreman\":{\"type\":\"string\"},\"receiver\":{\"type\":\"string\"},\"dateTimeOut\":{\"type\":\"string\"},\"jobNumber\":{\"type\":\"string\"},\"materialRowsJson\":{\"type\":\"string\"}}},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"},{\"name\":\"workOrder\",\"comment\":\"\"},{\"name\":\"foreman\",\"comment\":\"\"},{\"name\":\"receiver\",\"comment\":\"\"},{\"name\":\"dateTimeOut\",\"comment\":\"\"},{\"name\":\"jobNumber\",\"comment\":\"\"},{\"name\":\"materialRowsJson\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}