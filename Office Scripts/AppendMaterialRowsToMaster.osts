{"version":"0.3.0","body":"interface MaterialRow {\n  wo: string;\n  job: string;\n  po: string;\n  description: string;\n  quantity: number;\n  unit: string;\n}\n\nfunction cleanText(value: unknown): string {\n  if (value === null || value === undefined) return \"\";\n  return String(value)\n    .replace(/\\n/g, \" \")\n    .replace(/\\r/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction toWholeNumberOrBlank(value: unknown): number | string {\n  const text = cleanText(value)\n    .replace(/,/g, \"\")\n    .replace(/[^\\d]/g, \"\");\n\n  if (text === \"\") return \"\";\n\n  return Number(text);\n}\n\nfunction cleanJobNumber(value: unknown): number | string {\n  const text = cleanText(value);\n\n  if (text.toUpperCase() === \"PREFAB\") {\n    return \"Prefab\";\n  }\n\n  return toWholeNumberOrBlank(text);\n}\n\nfunction main(\n  workbook: ExcelScript.Workbook,\n  rows: MaterialRow[],\n  sharePointLink: string,\n  importedDate: string,\n  sourceAttachment: string\n): number {\n\n  const sheet = workbook.getWorksheets()[0];\n\n  if (!sheet) {\n    throw new Error(\"No worksheet found.\");\n  }\n\n  if (!rows || rows.length === 0) {\n    return 0;\n  }\n\n  const requiredHeaders = [\n    \"WO\",\n    \"Job #\",\n    \"PO\",\n    \"Description\",\n    \"Quantity\",\n    \"Unit\",\n    \"SharePointLink\",\n    \"Imported Date\",\n    \"SourceAttachment\"\n  ];\n\n  const usedRange = sheet.getUsedRange();\n\n  if (!usedRange) {\n    throw new Error(\"Master workbook has no used range/header row.\");\n  }\n\n  const headerValues = sheet.getRange(\"1:1\").getValues()[0];\n\n  const headerMap: Record<string, number> = {};\n\n  for (let i = 0; i < headerValues.length; i++) {\n    const header = cleanText(headerValues[i]);\n\n    if (header !== \"\") {\n      headerMap[header] = i;\n    }\n  }\n\n  const missingHeaders = requiredHeaders.filter(\n    h => headerMap[h] === undefined\n  );\n\n  if (missingHeaders.length > 0) {\n    throw new Error(\n      \"Missing required master headers: \" + missingHeaders.join(\", \")\n    );\n  }\n\n  let nextRow = 1;\n\n  const currentUsedRange = sheet.getUsedRange();\n\n  if (currentUsedRange) {\n    nextRow = currentUsedRange.getRowCount();\n  }\n\n  const output: (string | number)[][] = [];\n\n  for (const r of rows) {\n\n    const rowOut: (string | number)[] =\n      new Array(headerValues.length).fill(\"\");\n\n    rowOut[headerMap[\"WO\"]] =\n      toWholeNumberOrBlank(r.wo);\n\n    rowOut[headerMap[\"Job #\"]] =\n      cleanJobNumber(r.job);\n\n    rowOut[headerMap[\"PO\"]] =\n      cleanText(r.po);\n\n    rowOut[headerMap[\"Description\"]] =\n      cleanText(r.description);\n\n    rowOut[headerMap[\"Quantity\"]] =\n      Number(r.quantity);\n\n    rowOut[headerMap[\"Unit\"]] =\n      cleanText(r.unit);\n\n    rowOut[headerMap[\"SharePointLink\"]] =\n      cleanText(sharePointLink);\n\n    rowOut[headerMap[\"Imported Date\"]] =\n      cleanText(importedDate);\n\n    rowOut[headerMap[\"SourceAttachment\"]] =\n      cleanText(sourceAttachment);\n\n    output.push(rowOut);\n  }\n\n  sheet\n    .getRangeByIndexes(\n      nextRow,\n      0,\n      output.length,\n      headerValues.length\n    )\n    .setValues(output);\n\n  const firstDataRow = nextRow + 1;\n  const lastDataRow = nextRow + output.length;\n\n  sheet\n    .getRange(`A${firstDataRow}:A${lastDataRow}`)\n    .setNumberFormat(\"0\");\n\n  return output.length;\n}","description":"","noCodeMetadata":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[{\"name\":\"rows\",\"index\":0},{\"name\":\"sharePointLink\",\"index\":1},{\"name\":\"importedDate\",\"index\":2},{\"name\":\"sourceAttachment\",\"index\":3}],\"parameterSchema\":{\"type\":\"object\",\"required\":[\"rows\",\"sharePointLink\",\"importedDate\",\"sourceAttachment\"],\"properties\":{\"rows\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"wo\":{\"type\":\"string\"},\"job\":{\"type\":\"string\"},\"po\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"quantity\":{\"type\":\"number\"},\"unit\":{\"type\":\"string\"}}}},\"sharePointLink\":{\"type\":\"string\"},\"importedDate\":{\"type\":\"string\"},\"sourceAttachment\":{\"type\":\"string\"}}},\"returnSchema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"number\"}}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"},{\"name\":\"rows\",\"comment\":\"\"},{\"name\":\"sharePointLink\",\"comment\":\"\"},{\"name\":\"importedDate\",\"comment\":\"\"},{\"name\":\"sourceAttachment\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}