{"version":"0.3.0","body":"interface MaterialRow {\n  wo: string;\n  job: string;\n  po: string;\n  description: string;\n  quantity: number;\n  unit: string;\n}\n\nfunction cleanText(value: unknown): string {\n  if (value === null || value === undefined) return \"\";\n  return String(value).replace(/\\n/g, \" \").replace(/\\r/g, \" \").replace(/\\s+/g, \" \").trim();\n}\n\nfunction parseQuantityAndUnit(value: unknown): { quantity: number | null; unit: string } {\n  if (value === null || value === undefined) return { quantity: null, unit: \"\" };\n  if (typeof value === \"boolean\") return { quantity: null, unit: \"\" };\n\n  if (typeof value === \"number\") {\n    return { quantity: Math.round(value), unit: \"EA\" };\n  }\n\n  let text = cleanText(value);\n  if (text === \"\") return { quantity: null, unit: \"\" };\n\n  text = text.replace(/,/g, \"\");\n  let unit = \"EA\";\n\n  if (text.endsWith(\"'\")) {\n    unit = \"FT\";\n    text = text.slice(0, -1).trim();\n  }\n\n  if (/^\\d+\\.$/.test(text)) {\n    text = text.slice(0, -1);\n  }\n\n  if (/^\\d+(\\.0+)?$/.test(text)) {\n    return { quantity: Math.trunc(Number(text)), unit };\n  }\n\n  return { quantity: null, unit: \"\" };\n}\n\nfunction extractWoFromAnywhere(values: (string | number | boolean)[][]): string {\n  for (let r = 0; r < Math.min(values.length, 25); r++) {\n    for (let c = 0; c < Math.min(values[r].length, 12); c++) {\n      const text = cleanText(values[r][c]);\n      const match = text.match(/\\bWO\\s*#?\\s*([A-Za-z0-9\\-]+)\\b/i);\n      if (match) return cleanText(match[1]);\n    }\n  }\n\n  return \"\";\n}\n\nfunction extractJobNumberFromAnywhere(values: (string | number | boolean)[][]): string {\n  for (let r = 0; r < Math.min(values.length, 25); r++) {\n    for (let c = 0; c < Math.min(values[r].length, 12); c++) {\n      const text = cleanText(values[r][c]);\n      if (!text) continue;\n\n      const upper = text.toUpperCase();\n\n      const sameCell = text.match(/JOB(?:\\s*NUMBER|\\s*#)?\\s*[:#-]+\\s*(.+)$/i);\n      if (sameCell) {\n        const value = cleanText(sameCell[1]);\n        if (value && ![\"JOB\", \"JOB #\", \"JOB NUMBER\"].includes(value.toUpperCase())) {\n          return value;\n        }\n      }\n\n      if ([\"JOB NUMBER\", \"JOB #\", \"JOB\"].includes(upper)) {\n        const candidates: unknown[] = [\n          values[r]?.[c + 1],\n          values[r + 1]?.[c],\n          values[r + 1]?.[c + 1],\n          values[r]?.[c + 2],\n          values[r + 2]?.[c]\n        ];\n\n        for (const candidate of candidates) {\n          const candidateText = cleanText(candidate);\n          const candidateUpper = candidateText.toUpperCase();\n\n          if (candidateText && ![\"JOB\", \"JOB #\", \"JOB NUMBER\"].includes(candidateUpper)) {\n            return candidateText;\n          }\n        }\n      }\n    }\n  }\n\n  return \"\";\n}\n\nfunction findHeaderAndColumns(values: (string | number | boolean)[][]): {\n  headerRow: number | null;\n  qtyCol: number | null;\n  descCol: number | null;\n} {\n  for (let r = 0; r < values.length; r++) {\n    let qtyCol: number | null = null;\n    let descCol: number | null = null;\n\n    for (let c = 0; c < values[r].length; c++) {\n      const cellText = cleanText(values[r][c]).toUpperCase();\n\n      if (cellText.includes(\"QUANTITY\") || cellText === \"QTY\") {\n        qtyCol = c;\n      }\n\n      if (\n        cellText.includes(\"DESCRIPTION\") ||\n        cellText.includes(\"PART NUMBER\")\n      ) {\n        descCol = c;\n      }\n    }\n\n    if (qtyCol !== null && descCol !== null) {\n      return { headerRow: r, qtyCol, descCol };\n    }\n  }\n\n  return { headerRow: null, qtyCol: null, descCol: null };\n}\n\nfunction main(workbook: ExcelScript.Workbook): MaterialRow[] {\n  const sheet = workbook.getWorksheets()[0];\n  if (!sheet) throw new Error(\"No worksheet found.\");\n\n  const usedRange = sheet.getUsedRange();\n  if (!usedRange) return [];\n\n  const values = usedRange.getValues();\n\n  const wo = extractWoFromAnywhere(values);\n  const job = extractJobNumberFromAnywhere(values);\n  const po = \"\";\n\n  const found = findHeaderAndColumns(values);\n\n  if (found.headerRow === null || found.qtyCol === null || found.descCol === null) {\n    throw new Error(\"Could not find Quantity and Description/Part Number header columns.\");\n  }\n\n  const rows: MaterialRow[] = [];\n\n  for (let r = found.headerRow + 1; r < values.length; r++) {\n    const quantityValue = values[r]?.[found.qtyCol];\n    const descriptionValue = values[r]?.[found.descCol];\n\n    const parsed = parseQuantityAndUnit(quantityValue);\n    const description = cleanText(descriptionValue);\n\n    if (description === \"\") continue;\n    if (parsed.quantity === null) continue;\n\n    const descUpper = description.toUpperCase();\n\n    if ([\"TOTAL\", \"SUBTOTAL\", \"REQUIRED\", \"DATE REQUIRED\"].includes(descUpper)) {\n      continue;\n    }\n\n    rows.push({\n      wo,\n      job,\n      po,\n      description,\n      quantity: parsed.quantity,\n      unit: parsed.unit\n    });\n  }\n\n  return rows;\n}","description":"","noCodeMetadata":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"wo\":{\"type\":\"string\"},\"job\":{\"type\":\"string\"},\"po\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"quantity\":{\"type\":\"number\"},\"unit\":{\"type\":\"string\"}}}}}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}